# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored - never commit real credentials.

# --- Database (required for accounts + character sync) -----------------------
# Local MongoDB:            mongodb://127.0.0.1:27017
# MongoDB Atlas (hosted):   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=characterSheet

# --- Public URL of the app (used in password-reset email links) --------------
# Leave empty in development to use the URL the request came in on.
APP_URL=http://localhost:3000

# --- Outgoing email (password reset) -----------------------------------------
# If SMTP_HOST is empty, emails are NOT sent - the reset link is printed to the
# terminal running `npm run dev` instead, so the flow still works locally.
#
# Examples:
#   Gmail:    SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  (use an App Password)
#   Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); leave empty/false for 587 (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown in the email, e.g. "Character Sheet <no-reply@example.com>"
MAIL_FROM=
